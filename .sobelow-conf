# Sobelow configuration — SAST gate for the OpenSSF hardening track.
#
# Read by `mix sobelow` automatically. The CI step runs
# `mix sobelow --exit` (see .github/workflows/ci.yml), which inherits
# these defaults and returns non-zero on any *non-ignored* finding.
#
# WHY checks are ignored (each is a documented false-positive class for
# Glorbo's architecture, NOT a blanket silence):
#
#   Traversal.FileModule
#     Glorbo is a filesystem-orchestrator: ~/.glorbo/companies/ is the
#     source of truth (see CLAUDE.md load-bearing invariants), so nearly
#     every module performs File.* calls with computed paths. Sobelow's
#     Traversal.FileModule heuristic flags ANY File.* call whose path
#     isn't a string literal — 374 of 386 findings, virtually all Low
#     confidence. Path-confinement is enforced by the kernel policy
#     engine + bwrap mount namespaces (GEP-5), not by per-call string
#     checks, so this heuristic is structurally a false-positive
#     generator here. Confinement is verified by the sandbox test suite,
#     not by sobelow.
#
#   Config.HTTPS
#     Glorbo is a self-hosted single-binary app that binds 127.0.0.1.
#     Endpoint TLS is intentionally not configured for the loopback
#     listener; transport security for remote access is the operator's
#     reverse-proxy concern, out of scope for the bundled endpoint.
#
#   XSS.Raw / XSS.SendResp
#     - lib/glorbo_web/markdown.ex: Phoenix.HTML.raw/1 is called only
#       AFTER html_sanitize_ex allowlist sanitization (sanitize() stage
#       of the render pipeline). Sobelow can't see the sanitizer.
#     - lib/glorbo_web/mcp/plug.ex: send_resp/3 returns a plain-text 403
#       (no HTML content-type) with an inspect/1-escaped origin term.
#
#   SQL.Query
#     lib/glorbo/db/bootstrap.ex uses a parameterized query ("... name=?"
#     with [name] bound separately). No string interpolation into SQL.
#
#   CI.System
#     8 findings (all Low confidence), in lib/glorbo/doctor.ex,
#     lib/glorbo/sandbox/bwrap.ex, lib/glorbo/cli/* and
#     lib/glorbo/cli/lifecycle/distribution.ex. Every one invokes
#     System.cmd/2,3 with an ARGUMENT LIST (no shell, no string
#     interpolation into a command line) — e.g.
#     `System.cmd(path, ["--help"], stderr_to_stdout: true)` and
#     `cmd.("uname", ["-r"])`. The argv form is not shell-injectable;
#     sobelow's CI.System heuristic flags any System.cmd regardless of
#     arg shape. Reviewed individually during the OpenSSF hardening pass
#     — no true positive. Re-triage if a future finding uses a string
#     command or splices user input into argv.
[
  exit: true,
  threshold: :low,
  verbose: false,
  ignore: [
    "Traversal.FileModule",
    "Config.HTTPS",
    "XSS.Raw",
    "XSS.SendResp",
    "SQL.Query",
    "CI.System"
  ],
  ignore_files: [],
  skip: false,
  private: false
]
