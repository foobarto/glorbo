# The directory Mix will write compiled artifacts to.
/_build/

# Burrito writes the wrapped single-file binary here.
/burrito_out/

# Convenience symlink to the latest linux_x86_64 burrito build,
# maintained by `mix build.local` / end-of-task automation. Not
# checked in; build locally to materialise it.
/glorbo

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
glorbo-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*

# GSD and editor/OS debris (pre-phx-new entries)
.bg-shell/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
.env
.env.*
!.env.example
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log
coverage/
.cache/

# Agent assistant config — AGENTS.md, CLAUDE.md and the .claude/
# directory are local development tooling for AI coding assistants
# (Codex, Claude Code, etc). Not Glorbo source code.
/AGENTS.md
/CLAUDE.md
.claude/
.agents/
.agent/

# ElixirLS workspace (language-server cache, per-project).
.elixir_ls/

# direnv (per-project envrc).
.envrc

# Local release/backup artifacts — produced by `mix release`, `glorbo backup`,
# and the cosign signing step. None of these belong in the repo.
*.tar.gz
*.sig
# Local .reports/ — session outputs from audits/E2E runs; not source.
.reports/
*.png
# Track the design-handoff screenshots (checked in as pixel references
# cited by GEP-30). Everything else matching *.png stays ignored.
!.design/design_handoff_glorbo_tui/screenshots/*.png
# GEP-44 visual-regression baselines: PNG fixtures committed for
# diff-against on every CI / pre-cut run.
!test/fixtures/ui-baselines/**/*.png
# Landing-page screenshots: shipped with assets/index.html.
!assets/screenshots/*.png

# graphify transient outputs. `graph.json` is ~3 MB (binary-ish),
# `graph.html` 2 MB, `cache/` rebuilds from source. Only the
# curated report lives at `docs/knowledge-graph/GRAPH_REPORT.md`.
graphify-out/
**/graphify-out/
.codex
.reviews/
.playwright-mcp/

# GEP-45 Phase 2: stado bench scratch dir + pinned upstream binary.
# Reproducibility lives in `docs/research/bench-htb.md`, not vendored
# binaries (the pinned copy is operator-local).
.bench/
NOTES-*.md
