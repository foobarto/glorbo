# The directory Mix will write compiled artifacts to.
/_build/

# Burrito writes the wrapped single-file binary here.
/burrito_out/

# Convenience symlink to the latest linux_x86_64 burrito build,
# maintained by `mix build.local` / end-of-task automation. Not
# checked in; build locally to materialise it.
/glorbo

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
glorbo-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*

# GSD and editor/OS debris (pre-phx-new entries)
.bg-shell/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
.env
.env.*
!.env.example
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log
coverage/
.cache/

# External Claude Code skill plugins (symlinked from .claude/skills/).
# Not Glorbo source code. Versions pinned in skills-lock.json; re-hydrate
# via your skills installer.
.agents/
.agent/
.claude/scheduled_tasks.lock
.claude/worktrees/

# ElixirLS workspace (language-server cache, per-project).
.elixir_ls/

# direnv (per-project envrc).
.envrc

# Local release/backup artifacts — produced by `mix release`, `glorbo backup`,
# and the cosign signing step. None of these belong in the repo.
*.tar.gz
*.sig
.claude/launch.json

# Local .reports/ — session outputs from audits/E2E runs; not source.
.reports/
/REVIEW.md
/TESTPLAN.md
.claude/agents/
