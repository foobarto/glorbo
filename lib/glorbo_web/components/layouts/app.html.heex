<div class="gl-app-shell">
  <GlorboWeb.Components.Sidebar.sidebar current_company={assigns[:current_company]} health={assigns[:sidebar_health] || %{alerts: 0, crashed: 0}} />
  <main class="gl-main">
    <div :if={Phoenix.Flash.get(@flash, :error)} class="gl-banner gl-banner--muted" role="alert">
      {Phoenix.Flash.get(@flash, :error)}
    </div>
    <div :if={Phoenix.Flash.get(@flash, :info)} class="gl-banner gl-banner--muted" role="status">
      {Phoenix.Flash.get(@flash, :info)}
    </div>
    {@inner_content}
  </main>
  <div class="gl-disconnect-banner" role="status">Connection lost. Reconnecting…</div>
</div>
