<div class="gl-app-shell">
  <a href="#gl-main-content" class="gl-skip-link">Skip to main content</a>
  <GlorboWeb.Components.Topbar.topbar current_company={assigns[:current_company]} />
  <GlorboWeb.Components.Sidebar.sidebar
    current_company={assigns[:current_company]}
    active={assigns[:sidebar_active]}
  />
  <main id="gl-main-content" class="gl-main" tabindex="-1">
    <div
      :if={Phoenix.Flash.get(@flash, :error)}
      id="gl-flash-error"
      phx-hook="AutoDismissFlash"
      class="gl-banner gl-banner--error"
      role="alert"
    >
      <span class="gl-banner__glyph" aria-hidden="true">✗</span>
      <span class="gl-sr-only">Error:</span>
      {Phoenix.Flash.get(@flash, :error)}
    </div>
    <div
      :if={Phoenix.Flash.get(@flash, :info)}
      id="gl-flash-info"
      phx-hook="AutoDismissFlash"
      class="gl-banner gl-banner--info"
      role="status"
    >
      <span class="gl-banner__glyph" aria-hidden="true">✓</span>
      <span class="gl-sr-only">Info:</span>
      {Phoenix.Flash.get(@flash, :info)}
    </div>
    {@inner_content}
  </main>
  <GlorboWeb.Components.Statusbar.statusbar />
  <div class="gl-disconnect-banner" role="status">Connection lost. Reconnecting…</div>
</div>
